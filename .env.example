# Booking form delivery. Preferred: an n8n (or any) webhook that accepts JSON POSTs.
BOOKING_WEBHOOK_URL=

# Fallback: if BOOKING_WEBHOOK_URL is empty and RESEND_API_KEY is set,
# bookings are emailed to BOOKING_TO_EMAIL via Resend.
RESEND_API_KEY=
BOOKING_TO_EMAIL=
# Must be a sender on a domain verified in Resend.
BOOKING_FROM_EMAIL="Website <bookings@example.com>"

# Optional: canonical site URL (defaults to https://{domain} from content/site.ts)
NEXT_PUBLIC_SITE_URL=
